# Contraseña del panel /admin
ADMIN_PASSWORD=cambia-esta-clave

# Opcional: secret aparte para firmar la cookie de sesión
# ADMIN_SESSION_SECRET=

# En Vercel: Storage → Blob → Create → copiá el token
# Sin esto, los cambios del admin se guardan en data/novedades.json (solo local)
# BLOB_READ_WRITE_TOKEN=

# Opcional: feed RSS de En Clave PyME (default: linkedinrss.cns.me)
# LINKEDIN_NEWSLETTER_RSS_URL=https://linkedinrss.cns.me/en-clave-pyme-7462332384512782336

# Obligatorio para /api/novedades/sync (cron Vercel manda Bearer automático)
# Generar: openssl rand -hex 32
CRON_SECRET=
